\begin{figure}[htbp]
  \centering
  \SingleSpacing
  \caption{Curva ROC e calibração por faixas das probabilidades previstas no teste de 2026}
  \label{fig:roc}
  \includegraphics[width=0.76\linewidth]{figuras/roc-calibracao.png}
  \fonte{Elaborada pelos autores a partir dos dados do Infosiga-SP \parencite{infosiga2026}. À direita, o tamanho dos círculos cresce com $n$.}
