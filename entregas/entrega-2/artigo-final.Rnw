f  <- function(x, d = 4) formatC(x, format = "f", digits = d, decimal.mark = ",", big.mark = ".")
f_raw <- function(x, d = 4) formatC(x, format = "f", digits = d, decimal.mark = ",")
f_math <- function(x, d = 4) {
  vapply(x, function(v) {
    s <- formatC(abs(v), format = "f", digits = d, decimal.mark = ",")
    if (v < 0) paste0("$-", s, "$") else s
  }, character(1))
}
f0 <- function(x) formatC(as.integer(round(x)), format = "d", big.mark = ".")
pv <- function(x) ifelse(x < 0.0001, "$< 0{,}0001$", f_raw(x, 4))
tab_ibge <- function(df, nomes = names(df), align = NULL) {
  if (is.null(align)) {
    align <- vapply(df, function(col) if (is.numeric(col)) "r" else "l", character(1))
  }
  cat(knitr::kable(
    df,
    format = "latex",
    booktabs = TRUE,
    escape = FALSE,
    row.names = FALSE,
    col.names = nomes,
    align = align
  ), sep = "\n")
}

