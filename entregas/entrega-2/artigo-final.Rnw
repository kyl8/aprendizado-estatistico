f_math <- function(x, d = 4) {
  vapply(x, function(v) {
    s <- formatC(abs(v), format = "f", digits = d, decimal.mark = ",")
    if (v < 0) paste0("$-", s, "$") else s
  }, character(1))
}
f0 <- function(x) formatC(as.integer(round(x)), format = "d", big.mark = ".")
pv <- function(x) ifelse(x < 0.0001, "$< 0{,}0001$", f_raw(x, 4))
tab_ibge <- function(df, nomes = names(df), align = NULL) {
