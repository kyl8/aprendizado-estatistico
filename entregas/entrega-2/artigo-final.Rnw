f <- function(x,d=4) formatC(x,format="f",digits=d,decimal.mark=",")
f0 <- function(x) formatC(x,format="d",big.mark=".")
pv <- function(x) ifelse(x<.0001,"< 0,0001",f(x,4))
tab <- function(x,nomes=names(x)) cat(knitr::kable(x,format="latex",booktabs=TRUE,row.names=FALSE,col.names=nomes),sep="\n")
