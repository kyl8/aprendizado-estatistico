<<dados, include=FALSE>>=
# =========================================================================
# DADOS DO GRUPO APPA (Caminho relativo a partir de entregas/entrega-1/)
# =========================================================================
# Funciona compilando da raiz do repositorio ou de entregas/entrega-1/.
arquivo_rds <- "estrutura/corpus/banco-de-dados/sinistros_pico.rds"
if (!file.exists(arquivo_rds)) arquivo_rds <- file.path("..", "..", arquivo_rds)
dados    <- readRDS(arquivo_rds)
resposta <- "pico"
# =========================================================================

tex <- function(x) gsub("_", "\\\\_", x)

y            <- dados[[resposta]]
quantitativa <- is.numeric(y)
n            <- nrow(dados)
p            <- ncol(dados) - 1
resposta_tex <- tex(resposta)

# --- linha de base: desempenho do palpite ingênuo ------------------------
if (quantitativa) {
  valor_base       <- sd(y, na.rm = TRUE)
  texto_base       <- paste0("RMSE = ", format(round(valor_base, 2), nsmall = 2))
  nome_base        <- "chutar sempre a m\\'edia"
  palavra_tipo     <- "regress\\~ao"
  palavra_resposta <- "quantitativa"
  palavra_metrica  <- "RMSE, na unidade de $Y$"
} else {
  valor_base       <- max(table(y)) / sum(table(y))
  texto_base       <- paste0("acur\\'acia = ", format(round(valor_base, 3), nsmall = 3))
  nome_base        <- "chutar a classe mais comum"
  palavra_tipo     <- "classifica\\c{c}\\~ao"
  palavra_resposta <- "qualitativa"
  palavra_metrica  <- "acur\\'acia e AUC"
}

# --- suspeita de vazamento -----------------------------------------------
num <- dados[sapply(dados, is.numeric)]
if (quantitativa && ncol(num) > 1) {
  cc <- abs(cor(num, use = "complete.obs")[, resposta])
  cc <- sort(cc[names(cc) != resposta], decreasing = TRUE)
  texto_cor <- paste0("\\texttt{", tex(names(cc)[1]), "}: ", format(round(cc[1], 3), nsmall = 3))
} else {
  texto_cor <- "n\\~ao se aplica (resposta qualitativa)"
}

# --- balanço das classes e valores faltantes -----------------------------
if (quantitativa) {
  texto_balanco <- "n\\~ao se aplica (resposta quantitativa)"
} else {
  texto_balanco <- paste(paste0("\\texttt{", tex(names(table(y))), "}: ", as.integer(table(y))), collapse = " | ")
}

tab_y     <- table(y)
n_pico    <- as.integer(tab_y[["Pico"]])
n_fora    <- as.integer(tab_y[["Fora do Pico"]])
pct_pico  <- format(round(100 * n_pico / n, 1), decimal.mark = ",")
pct_fora  <- format(round(100 * n_fora / n, 1), decimal.mark = ",")

faltantes <- colSums(is.na(dados))
texto_falta <- if (sum(faltantes) == 0) {
  "nenhum"
} else {
  paste(paste0("\\texttt{", tex(names(faltantes)[faltantes > 0]), "}: ", faltantes[faltantes > 0]), collapse = " | ")
}
@

